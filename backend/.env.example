# ═══════════════════════════════════════════════════════════
# OptiFleet B2B — Environment Variables
# Copiază acest fișier ca .env și completează valorile
# NU adăuga niciodată .env în Git!
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────
# SUPABASE
# Dashboard → Settings → API
# ───────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ───────────────────────────────────────
# AI — CONVERSATIONAL (Claude)
# https://console.anthropic.com
# ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ───────────────────────────────────────
# AI — TEHNIC (Qwen3 via Ollama local)
# Instalare: https://ollama.com
# Pull model: ollama pull qwen3:14b
# ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
QWEN3_MODEL=qwen3:14b

# ───────────────────────────────────────
# ROUTING (OSRM local Docker)
# Pornire: docker-compose up -d osrm
# ───────────────────────────────────────
OSRM_BASE_URL=http://localhost:5000

# ───────────────────────────────────────
# CACHE (Redis local Docker)
# SAU Upstash: rediss://user:pass@host:port
# ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ───────────────────────────────────────
# SECURITATE JWT
# Generare: openssl rand -hex 32
# ───────────────────────────────────────
SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ───────────────────────────────────────
# APLICAȚIE
# ───────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
APP_PORT=8000
