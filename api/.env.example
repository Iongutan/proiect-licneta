# ═══════════════════════════════════════════════════════════
# OptiFleet B2B — Rust API Environment Variables
# Copiază în api/.env și completează valorile reale
# ═══════════════════════════════════════════════════════════

# App
APP_PORT=8000
ENVIRONMENT=development   # development | staging | production

# Supabase (https://supabase.com → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT (ACELAȘI secret ca în Supabase → Settings → API → JWT Secret)
SECRET_KEY=your_jwt_secret_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Redis
REDIS_URL=redis://localhost:6379

# Python ML Service (intern)
ML_SERVICE_URL=http://localhost:8001

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
RUST_LOG=optifleet_api=info,tower_http=warn
