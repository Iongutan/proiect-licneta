# OptiFleet — frontend (Next.js). Opțional: copiază în frontend/.env.local.
# Baza de date locală NU se configurează aici: `npm run dev` (din rădăcina
# proiectului) o pornește și îi transmite singur conexiunea din .data/.

# ── Servicii opționale (doar pe server) ───────────────────────────────────
ML_SERVICE_URL=http://127.0.0.1:8001
# Același secret ca INTERNAL_API_TOKEN din ml_service/.env (openssl rand -hex 32)
ML_SERVICE_TOKEN=
OSRM_URL=http://127.0.0.1:5000
