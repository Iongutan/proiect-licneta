{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶️ Pornește OptiFleet (Dev Server & Docker)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Ready in.*|.*Local:.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "🛑 Oprește OptiFleet",
      "type": "shell",
      "command": "npm run stop",
      "problemMatcher": []
    }
  ]
}
